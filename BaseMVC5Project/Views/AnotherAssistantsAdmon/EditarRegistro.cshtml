    async function generarVistaPrevia(idioma) {
        try {
            showLoader();
            let form = document.getElementById('frm-registro-invitado');
            $('#IdiomaInvitacion').val(idioma);
            let formJson = serializeForm(form);
            let url = "@Url.Content("~/AnotherAssistantsAdmon/DescargaPDFVistaPrevia")";
            const response = httpPost(
                url,
                formJson
            );
            const dataResponse = await response
                .then(data => {
                    return data;
                })
                .catch(error => {
                    console.log(error);
                    btnEnviarAvisoPrivacidad.disabled = false;
                    hideLoader();
                });

            if (dataResponse.response === false) {
                let messageError = dataResponse.message;
                setErrorMessageForm(messageError, 'modalAlertMessageResult');
                popupAlert.classList.add('show');
            }
            else {
                const blob = base64ToBlob(dataResponse.result);
                const url = URL.createObjectURL(blob);

                document.getElementById("pdfViewer").src = url;
            }
        }
        catch (e) {
            setErrorMessageForm(messageError, 'modalAlertMessageResult');
        }
        finally {
            hideLoader();
        }
    }

    function base64ToBlob(b64Data, contentType = 'application/pdf') {
        const sliceSize = 512;
        const byteCharacters = atob(b64Data.replace(/\s/g, '')); // decodificar Base64
        const byteArrays = [];

        for (let offset = 0; offset < byteCharacters.length; offset += sliceSize) {
            const slice = byteCharacters.slice(offset, offset + sliceSize);
            const byteNumbers = new Array(slice.length);
            for (let i = 0; i < slice.length; i++) {
                byteNumbers[i] = slice.charCodeAt(i);
            }
            byteArrays.push(new Uint8Array(byteNumbers));
        }
        return new Blob(byteArrays, { type: contentType });
    }

    function cerrarModalAlert() {
        popupAlert.classList.remove('show');
    }

    async function CargaExcel() {
     try {
         showLoader();

         let form = document.getElementById('frm-registro-invitado');
         var formData = new FormData(form);
         let url = "@Url.Content("~/AnotherAssistantsAdmon/CargaOtrosAsistentes")";

          $.ajax({
                type: 'POST',
                url: url,
              data: formData,
              contentType: false,  // Importante
              processData: false,  // Importante
              success: function (dataResponse) {
                  if (dataResponse.response === false) {
                      let messageError = dataResponse.message;
                      setErrorMessageForm(messageError, 'modalAlertMessageResult');
                      popupAlert.classList.add('show');
                  }
                  else {
                      $('#modalAlertMessageResult').one('hidden.bs.modal', function () {
                          window.location.reload();
                      });
                      let message= dataResponse.message;
                      setSuccessMessageForm(message, 'modalAlertMessageResult');
                      popupAlert.classList.add('show');

                  }
                },
                error: function (error) {

                }
            });


     }
     catch (e) {
         setErrorMessageForm(e, 'modalAlertMessageResult');
     }
     finally {
         hideLoader();
     }
    }

